{
  "projectName": "is-a.store",
  "rootDomain": "is-a.store",
  "dnsLiveMode": false,
  "dnsSyncEnabled": false,
  "dnsStatusNote": "Staging mode: .store is a paid commercial TLD and cannot be registered for ₹0. PR validation, registry indexing, and GitHub Pages hosting are live; DNS provisioning activates once a delegated root domain (paid .store or free NS-delegated community domain like eu.org / dpdns.org) is linked to Cloudflare.",
  "repository": {
    "owner": "RivetandRaster",
    "name": "is-a-store",
    "branch": "main",
    "url": "https://github.com/RivetandRaster/is-a-store"
  },
